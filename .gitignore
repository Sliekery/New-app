# Playwright is installed on demand for in-browser verification of the game
# (rendering, animations, UI screens). It is a throwaway tool dependency, not
# part of the game, which ships as plain HTML/JS with no build step.
node_modules/
package-lock.json

# Packages built for upload (itch.io zips and their unpacked staging). Made
# from committed sources by voidspire/tools/build-itch.js in one command, so
# committing the binaries would only be a second copy going stale.
voidspire/dist/
